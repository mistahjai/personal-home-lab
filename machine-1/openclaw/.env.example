# OpenClaw Configuration
# Copy this file to .env and fill in your values

# =========================================================================
# DOCKER IMAGE CONFIGURATION
# =========================================================================
# Docker image to use (options: ghcr.io/openclaw/openclaw:latest, openclaw/openclaw:latest, ghcr.io/openclaw/openclaw:latest-browser)
OPENCLAW_GATEWAY_IMAGE=ghcr.io/openclaw/openclaw:latest-browser
OPENCLAW_CLI_IMAGE=ghcr.io/openclaw/openclaw:latest

# Gateway port on host (default: 18789)
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_WEBHOOK_PORT=18790

# OpenClaw Admin Token (Pick a secure, unique 32-character phrase). You can generate one with: openssl rand -base64 32
OPENCLAW_GATEWAY_TOKEN=ogt_my_secure_32char_hex_token_123456

# =========================================================================
# OPTIONAL SETTINGS
# =========================================================================
# Enable agent sandbox (requires additional configuration)
OPENCLAW_GATEWAY_MODE=local
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_FORCE_INIT=true
OPENCLAW_SKIP_ONBOARDING=1
OPENCLAW_SANDBOX=1

OPENCLAW_AGENTS_DEFAULTS_SANDBOX_MODE=non-main
OPENCLAW_AGENTS_DEFAULTS_SANDBOX_BACKEND=docker
OPENCLAW_AGENTS_DEFAULTS_SANDBOX_SCOPE=session
OPENCLAW_AGENTS_DEFAULTS_SANDBOX_WORKSPACEACCESS=none

# Sandbox Architecture Variables
OPENCLAW_DOCKER_SOCKET=/var/run/docker.sock
# Timezone
TZ=Europe/Paris

# HOST SECURITY PASSTHROUGH: 
# Run `stat -c '%g' /var/run/docker.sock` on your host terminal and place the numeric ID here.
# This aligns your host's docker group configuration with the container.
DOCKER_GID=999

# =========================================================================
# PROVIDER API KEYS
# =========================================================================
# At least one provider API key is required

# Custom Smart LLM Gateway Setup
OPENCLAW_PROVIDER=custom
OPENCLAW_CUSTOM_ENDPOINT=http://192.168.1
OPENCLAW_CUSTOM_MODEL=auto
OPENCLAW_CUSTOM_API_KEY=your_smart_gateway_api_token_here

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# =========================================================================
# CHANNEL CREDENTIALS (configure as needed)
# =========================================================================
# Telegram: Get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# HEADLESS TELEGRAM SECURITY WHITELIST: Input your numeric Telegram ID here. Separate multiple IDs with commas (e.g. 123456789,987654321)
TELEGRAM_DM_POLICY=allowlist # Locks DMs strictly down to the explicit whitelist
TELEGRAM_GROUP_POLICY=disabled # Drops group chat permissions entirely for ironclad security
TELEGRAM_ALLOWED_IDS=123456789
TELEGRAM_ALLOW_FROM=123456789



# Discord: Get from Discord Developer Portal
# DISCORD_TOKEN=your_discord_bot_token_here

# Slack: Get from Slack App configuration
# SLACK_BOT_TOKEN=xoxb_your_slack_bot_token_here

# WhatsApp: Use WhatsApp Business API
# WHATSAPP_TOKEN=your_whatsapp_token_here

# Signal: Use signal-cli REST API
# SIGNAL_PHONE_NUMBER=+1234567890

