# Nextcloud Configuration
# Copy this file to .env and fill in your values

# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
# PostgreSQL database name
POSTGRES_DB=nextcloud

# PostgreSQL user
POSTGRES_USER=nextcloud

# PostgreSQL password (use a strong random password!)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# =========================================================================
# NEXTCLOUD CONFIGURATION
# =========================================================================
# Host port for Nextcloud web interface (default: 8080)
NEXTCLOUD_PORT=8080

# Admin username (default: admin)
NEXTCLOUD_ADMIN_USER=admin

# Admin password (use a strong password!)
NEXTCLOUD_ADMIN_PASSWORD=your_secure_admin_password_here


# Trusted proxies (comma-separated, for reverse proxy setups)
# Example: TRUSTED_PROXIES=172.18.0.0/16,192.168.0.0/16
# TRUSTED_PROXIES=

# Overwrite protocol (for HTTPS behind reverse proxy)
# Example: OVERWRITEPROTOCOL=https
# OVERWRITEPROTOCOL=

# =========================================================================
# OPTIONAL SETTINGS
# =========================================================================
# Timezone
TZ=Europe/Paris