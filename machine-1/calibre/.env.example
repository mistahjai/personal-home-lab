# Calibre Configuration
# Copy this file to .env and fill in your values

# Host port for Calibre web interface (default: 3003)
CALIBRE_PORT=3003
CALIBRE_CONTENT_PORT=3004

# Path to ebook library (default: /path/to/ebooks)
CALIBRE_DATA=/path/to/ebooks

CALIBRE_IMPORT_DATA=/path/to/import/ebooks

TZ=Europe/Paris
