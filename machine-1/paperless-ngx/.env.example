# Paperless-ngx Configuration
# Copy this file to .env and fill in your values

# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
# PostgreSQL database name
PAPERLESS_DBNAME=paperless
POSTGRES_DB=paperless

# PostgreSQL user
PAPERLESS_DBUSER=paperless
POSTGRES_USER=paperless

# PostgreSQL password (use a strong random password!)
PAPERLESS_DBPASS=your_secure_postgres_password_here
POSTGRES_PASSWORD=your_secure_postgres_password_here
# =========================================================================
# PAPERLESS-NGX CONFIGURATION
# =========================================================================
# Host port for Paperless-ngx web interface (default: 8000)
PAPERLESS_PORT=8000

# Admin username (default: admin)
PAPERLESS_ADMIN_USER=admin

# Admin password (use a strong password!)
PAPERLESS_ADMIN_PASSWORD=your_secure_admin_password_here

# Django secret key (generate with: openssl rand -base64 48)
PAPERLESS_SECRET_KEY=your_django_secret_key_here

# OCR Language (default: eng)
# For multiple languages, use PAPERLESS_OCR_LANGUAGES=eng+fra+deu
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=eng

# Timezone
PAPERLESS_TIME_ZONE=Europe/Paris

# Optional: URL for reverse proxy (include protocol and domain)
# Example: PAPERLESS_URL=https://paperless.example.com
# PAPERLESS_URL=

# =========================================================================
# OPTIONAL SETTINGS
# =========================================================================
# Consumer directory poll interval (seconds)
# PAPERLESS_CONSUMER_POLLING=300

# Enable OCR
# PAPERLESS_OCR_ENABLED=1

# Image DPI for OCR
# PAPERLESS_OCR_DPI=300


