# Stirling PDF Configuration
# Copy this file to .env and fill in your values

# Host port for Stirling PDF web interface (default: 3002)
STIRLING_PORT=3002

# Path to PDF files directory (default: /path/to/pdf/files)
STIRLING_DATA=/path/to/pdf/files

# Security - enable login (default: false)
STIRLING_SECURITY_ENABLELOGIN=false

# Default locale (default: en-US)
STIRLING_SYSTEM_DEFAULTLOCALE=en-GB

# Timezone (default: Europe/Paris)
TZ=Europe/Paris