# Zotero + WebDAV Combined Configuration
# Copy this file to .env and fill in your values

# Zotero
ZOTERO_PORT=3005

# WebDAV
WEBDAV_PORT=9800
WEBDAV_DATA=/path/to/webdav/storage

TZ=Europe/Paris

CUSTOM_USER=your_username_here
PASSWORD=your_secure_password_here

DAV_USERNAME=your_dav_username_here
DAV_PASSWORD=your_dav_password_here
