# Uptime Kuma Configuration
# Copy this file to .env and fill in your values

# Host port for Uptime Kuma web interface (default: 3001)
UPTIME_KUMA_PORT=3001

# Request timeout in seconds (default: 10)
UP_TIMEOUT=10

# Number of retries before alert (default: 3)
UP_RETRY_ALERT=3

# Timezone
TZ=Europe/Paris