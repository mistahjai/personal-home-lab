# Reading Stack Configuration
# Copy this file to .env and fill in your values

# =========================================================================
# GENERAL SETTINGS
# =========================================================================
TZ=Europe/Paris
BASE_DOMAIN=http://localhost

# =========================================================================
# MINIFLUX CONFIGURATION
# =========================================================================
MINIFLUX_PORT=8081
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASS=your_miniflux_admin_password_here
MINIFLUX_DB_USER=miniflux
MINIFLUX_DB_PASS=your_miniflux_db_password_here

# =========================================================================
# WALLABAG CONFIGURATION
# =========================================================================
WALLABAG_PORT=8082
WALLABAG_DB_ROOT_PASS=your_wallabag_root_password_here
WALLABAG_DB_USER=wallabag
WALLABAG_DB_PASS=your_wallabag_db_password_here

# =========================================================================
# KARAKEEP (HOARDER) CONFIGURATION
# =========================================================================
KARAKEEP_PORT=3333
# Generate a random string for NEXTAUTH_SECRET (e.g., openssl rand -base64 36)
KARAKEEP_AUTH_SECRET=your_auth_secret_here
KARAKEEP_MEILI_KEY=your_meili_master_key_here

# =========================================================================
# REMOTE LLM SERVER (OLLAMA) CONFIGURATION
# =========================================================================
# Replace with the ACTUAL IP ADDRESS of your separate machine running Llama
REMOTE_OLLAMA_IP=your_ollama_server_ip_here
REMOTE_OLLAMA_PORT=11434

# Inference tuning
KARAKEEP_AI_MODEL=llama3.1:8b
# Explicitly expands the text the model reads (8k tokens is highly recommended)
KARAKEEP_AI_CONTEXT=8192