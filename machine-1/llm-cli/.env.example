# LLM CLI Configuration
# Copy this file to .env and fill in your values

# =========================================================================
# API Keys (get from: aistudio.google.com, platform.openai.com, etc.)
# =========================================================================

# NVIDIA API Key (for NVIDIA models via Bifrost/FreeLLMAPI)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Cerebras API Key (optional)
CEREBRAS_API_KEY=csk-your_cerebras_key_here

# ZAI API Key (optional)
ZAI_API_KEY=your_zai_key_here

# Cohere API Key (optional)
COHERE_API_KEY=your_cohere_key_here

# Cloudflare API Key (optional)
CLOUDFARE_API_KEY=cfut_your_cloudflare_key_here

# Cloudflare Account ID (optional)
CLOUDDARE_ACCOUNT_ID=your_account_id_here

# Navy API Key (optional)
NAVY_API_KEY=sk-navy_your_navy_key_here

# FreeLLMAPI Token
FREELLMAPI_TOKEN=freellmapi_your_token_here

# Brave Search API Key (optional)
BRAVE_API_KEY=your_brave_key_here

# Encryption Key (for Bifrost)
ENCRYPTION_KEY=your_encryption_key_here

# =========================================================================
# Network & Path Configuration
# =========================================================================

# Host IP and port for FreeLLMAPI (format: IP:PORT)
# Use 127.0.0.1 for local only, or 0.0.0.0 for all interfaces
HOST_IP_PORT=127.0.0.1:3001

# Workspace path for development (mounted to /workspace in container)
WORKSPACE_PATH=/path/to/your/git/repos

# =========================================================================
# TELEGRAM Bot Configuration
# =========================================================================

TELEGRAM_AGY_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_AGY_BOT_USERNAME=your_bot_username

TELEGRAM_CLAUDE_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11  
TELEGRAM_CLAUDE_BOT_USERNAME=your_bot_username

ALLOWED_USERS=123456789

DISCORD_BOT_TOKEN=your_discord_bot_token_here



