# ─── Required ────────────────────────────────────────────────────────────────
# Absolute host path to your GGUF models. Mounted read-only at /models.
MODELS_FOLDER_PATH=/path/to/your/models
# API key used by open-webui to authenticate against llama-server.
# Must match the key stored in ./config/.apiKeys
LLAMA_API_KEY=sk-local-llama

# ─── llama-server ────────────────────────────────────────────────────────────
PORT=8080
UI_PORT=9092
HOST=0.0.0.0
SHM_SIZE=12g
MEMORY_LIMIT=12.8G
# CPU cores llama.cpp may use. Leave empty for all cores.
CPUSET=0-7
THREADS=6
MODELS_MAX=1
LOG_VERBOSITY=4
CACHE_RAM=0
PARALLEL=2
# Unload a model after this many seconds of inactivity. 0 disables.
SLEEP_IDLE_SECONDS=900
# Path to the api key file, read from inside the container.
API_KEY_FILE=/config/.apiKeys