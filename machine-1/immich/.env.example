# Immich Configuration
# Copy this file to .env and fill in your values

# The location where your uploaded files are stored
# Use an absolute path or relative to docker-compose.yml
UPLOAD_LOCATION=/path/to/your/photos/videos

# External library location (optional - for read-only access)
EXTERNAL_LIB_LOCATION=/path/to/your/external/photos/videos

# The location where your database files are stored
# Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# To set a timezone, uncomment and change to a TZ identifier
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
# See https://github.com/immich-app/immich/releases
IMMICH_VERSION=v3

# Connection secret for postgres. Use a strong random password!
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
POSTGRES_PASSWORD=your_secure_postgres_password_here

# The values below this line do not need to be changed
###################################################################################
POSTGRES_USER=postgres
POSTGRES_DB=immich