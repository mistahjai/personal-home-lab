# ─── Required ────────────────────────────────────────────────────────────────
# Absolute host path to your GGUF models. Mounted read-only at /models.
MODELS_FOLDER_PATH=/path/to/your/models

# ─── llama-server (Intel SYCL / iGPU) ────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
SHM_SIZE=12g
MEMORY_LIMIT=12.8G
# render and video group IDs from `getent group render video`
GID=39
UID=105
# Offload every layer to the iGPU.
N_GPU_LAYERS=99
THREADS=4
MODELS_MAX=1
LOG_VERBOSITY=4
FLASH_ATTN=on
CACHE_RAM=0
PARALLEL=2
# Unload a model after this many seconds of inactivity. 0 disables.
SLEEP_IDLE_SECONDS=900
# Path to the api key file, read from inside the container.
API_KEY_FILE=/config/.apiKeys

# ─── Optional: custom build ──────────────────────────────────────────────────
# Only used if you uncomment the `build:` block in docker-compose.yml.
# LLAMA_CPP_REPO=/path/to/llama.cpp